{
    "name": "@hodfords/nestjs-mailer",
    "version": "12.3.0",
    "packageManager": "pnpm@12.0.0",
    "description": "Simplifies sending emails in NestJS apps",
    "main": "./index.js",
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "tsc",
        "postbuild": "cp package.json dist && cp README.md dist && cp .npmrc dist",
        "format": "prettier --write \"lib/**/*.ts\"",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "prepare": "is-ci || husky",
        "version": "auto-changelog && git add CHANGELOG.md",
        "release:patch": "git add CHANGELOG.md && pnpm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "lint-staged": "lint-staged",
        "cspell": "cspell",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-mailer.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-mailer/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-mailer#readme",
    "dependencies": {
        "es-toolkit": "1.52.0",
        "eslint-config-prettier": "10.1.8",
        "handlebars": "*",
        "mjml": "5.4.0",
        "nodemailer": "9.0.6",
        "validator": "13.15.35"
    },
    "peerDependencies": {
        "@nestjs/bullmq": ">=12.0.0",
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "bullmq": ">=5.0.0",
        "handlebars": "*"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@nestjs/bullmq": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/mjml": "5.0.0",
        "@types/node": "26.4.0",
        "@types/nodemailer": "8.0.1",
        "@types/validator": "13.15.10",
        "auto-changelog": "2.6.0",
        "bullmq": "6.3.2",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "type": "module",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
